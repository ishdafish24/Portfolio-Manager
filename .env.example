# Copy this file to .env and fill in the values you want to use.

# Trading 212
# Use demo while testing, then switch to live.
T212_ENV=demo
T212_API_KEY=
# Optional. If set, the app uses Basic auth with key:secret.
T212_API_SECRET=

# Storage
REPORT_DB_PATH=portfolio_snapshots.sqlite3

# Optional market/news/earnings enrichment via Finnhub.
# Free plans may have strict limits, so the app still works without this.
FINNHUB_API_KEY=

# Optional X recent search enrichment.
X_BEARER_TOKEN=
X_POSTS_PER_SYMBOL=25

# Email delivery. Leave SMTP_HOST blank to print the report instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# Report tuning
REPORT_TOP_MOVERS=8
REPORT_CURRENCY_SYMBOL=$

